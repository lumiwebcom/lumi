# Port the server listens on
PORT=3000

# Google sign-in (optional). Create an OAuth 2.0 "Web application" Client ID at
# https://console.cloud.google.com/apis/credentials and add your site URL
# (e.g. http://localhost:3000) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# TURN server (optional, recommended for production). Without TURN, some calls
# between people on strict networks (corporate Wi-Fi, some mobile carriers) won't connect.
# TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Where the database and uploads are stored
# DATA_DIR=./data

# Set to production when serving over HTTPS (marks the session cookie Secure)
# NODE_ENV=production
